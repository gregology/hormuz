{
  "name": "hormuz",
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild"]
  },
  "scripts": {
    "dev:client": "pnpm --filter client dev",
    "dev:playground": "pnpm --filter playground dev",
    "dev:map-editor": "pnpm --filter @hormuz/map-editor dev",
    "dev:server": "cd server && uv run uvicorn hormuz.main:app --reload --host 0.0.0.0 --port 8000",
    "build:client": "pnpm --filter client build",
    "build:playground": "pnpm --filter playground build",
    "generate": "cd server && uv run python ../shared/scripts/generate.py",
    "generate:heightmap": "uv run shared/scripts/generate_heightmap.py",
    "generate:coastlines": "uv run shared/scripts/generate_coastlines.py",
    "test": "pnpm --filter client test",
    "lint:client": "pnpm --filter client lint",
    "lint:playground": "pnpm --filter playground lint",
    "lint:server": "cd server && uv run ruff check .",
    "format:server": "cd server && uv run ruff format ."
  },
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531"
}
